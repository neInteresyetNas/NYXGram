diff --git a/Ghostgram/Features/NYXToolkit/Core/NYXEventLog.swift b/Ghostgram/Features/NYXToolkit/Core/NYXEventLog.swift
new file mode 100644
index 00000000..62499065
--- /dev/null
+++ b/Ghostgram/Features/NYXToolkit/Core/NYXEventLog.swift
@@ -0,0 +1,61 @@
+import Foundation
+
+public enum NYXEventSeverity: String, Codable, CaseIterable {
+    case info, notice, warning
+}
+
+public struct NYXEvent: Codable, Equatable {
+    public var date: Date
+    public var severity: NYXEventSeverity
+    public var source: String
+    public var text: String
+    public init(date: Date, severity: NYXEventSeverity, source: String, text: String) {
+        self.date = date; self.severity = severity; self.source = source; self.text = text
+    }
+}
+
+public struct NYXEventLogData: Codable, Equatable {
+    public var events: [NYXEvent] = []
+    public init() {}
+}
+
+/// Local event log of what NYXGram features did ("Gifts: pinned X", "Import: settings restored").
+/// Capped; text is cut so the log can never grow without bound. It stays on the device.
+public final class NYXEventLog {
+    public static let maxEvents = 500
+    public static let maxTextLength = 300
+    public static let shared = NYXEventLog(url: FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0].appendingPathComponent("NYXGram/event-log.json"))
+
+    private let file: NYXJSONFile<NYXEventLogData>
+
+    public init(url: URL) {
+        self.file = NYXJSONFile(url: url, defaultValue: NYXEventLogData())
+    }
+
+    public var events: [NYXEvent] { return self.file.value.events }
+    public var wasRecovered: Bool { return self.file.recovered }
+
+    public func record(_ severity: NYXEventSeverity = .info, source: String, _ text: String, now: Date = Date()) {
+        let event = NYXEvent(date: now, severity: severity, source: String(source.prefix(40)), text: String(text.prefix(NYXEventLog.maxTextLength)))
+        self.file.update { data in
+            data.events.append(event)
+            if data.events.count > NYXEventLog.maxEvents {
+                data.events.removeFirst(data.events.count - NYXEventLog.maxEvents)
+            }
+        }
+    }
+
+    public func clear() {
+        self.file.update { $0.events = [] }
+    }
+
+    /// Newest first, optionally limited to a severity and a search text.
+    public func query(severity: NYXEventSeverity? = nil, search: String = "") -> [NYXEvent] {
+        let needle = search.trimmingCharacters(in: .whitespaces).lowercased()
+        return self.events.reversed().filter { event in
+            if let severity = severity, event.severity != severity { return false }
+            if needle.isEmpty { return true }
+            return event.text.lowercased().contains(needle) || event.source.lowercased().contains(needle)
+        }
+    }
+}
diff --git a/Ghostgram/Features/NYXToolkit/Core/NYXJSONFile.swift b/Ghostgram/Features/NYXToolkit/Core/NYXJSONFile.swift
new file mode 100644
index 00000000..50f06359
--- /dev/null
+++ b/Ghostgram/Features/NYXToolkit/Core/NYXJSONFile.swift
@@ -0,0 +1,59 @@
+import Foundation
+
+/// One small JSON file with an atomic write, a backup of the previous good version and quarantine of a
+/// damaged file (never silently deleted).
+public final class NYXJSONFile<Value: Codable & Equatable> {
+    private let url: URL
+    private let lock = NSLock()
+    public private(set) var value: Value
+    public private(set) var recovered = false
+
+    public init(url: URL, defaultValue: Value) {
+        self.url = url
+        self.value = defaultValue
+        try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true, attributes: nil)
+        if let main = NYXJSONFile.read(url, as: Value.self) {
+            self.value = main
+        } else if FileManager.default.fileExists(atPath: url.path) {
+            self.recovered = true
+            let stamp = Int(Date().timeIntervalSince1970)
+            try? FileManager.default.moveItem(at: url, to: url.appendingPathExtension("corrupt-\(stamp)"))
+            if let backup = NYXJSONFile.read(url.appendingPathExtension("bak"), as: Value.self) {
+                self.value = backup
+            }
+        }
+    }
+
+    private static func read<T: Decodable>(_ url: URL, as type: T.Type) -> T? {
+        guard let data = try? Data(contentsOf: url) else { return nil }
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        return try? decoder.decode(T.self, from: data)
+    }
+
+    @discardableResult
+    public func update(_ change: (inout Value) -> Void) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        var next = self.value
+        change(&next)
+        guard next != self.value else { return true }
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        encoder.dateEncodingStrategy = .iso8601
+        guard let data = try? encoder.encode(next) else { return false }
+        let fm = FileManager.default
+        if fm.fileExists(atPath: self.url.path), NYXJSONFile.read(self.url, as: Value.self) != nil {
+            let backup = self.url.appendingPathExtension("bak")
+            try? fm.removeItem(at: backup)
+            try? fm.copyItem(at: self.url, to: backup)
+        }
+        do {
+            try data.write(to: self.url, options: [.atomic])
+            self.value = next
+            return true
+        } catch {
+            return false
+        }
+    }
+}
diff --git a/Ghostgram/Features/NYXToolkit/Core/NYXMessageFilter.swift b/Ghostgram/Features/NYXToolkit/Core/NYXMessageFilter.swift
new file mode 100644
index 00000000..a57e5f39
--- /dev/null
+++ b/Ghostgram/Features/NYXToolkit/Core/NYXMessageFilter.swift
@@ -0,0 +1,77 @@
+import Foundation
+
+public enum NYXFilterKind: String, Codable, CaseIterable {
+    case keyword      // case-insensitive substring
+    case wholeWord    // case-insensitive, word boundaries
+    case regex        // NSRegularExpression, validated
+}
+
+public enum NYXFilterAction: String, Codable, CaseIterable {
+    case hide, highlight, mute
+}
+
+public struct NYXFilterRule: Codable, Equatable, Identifiable {
+    public var id: UUID
+    public var name: String
+    public var enabled: Bool
+    public var kind: NYXFilterKind
+    public var pattern: String
+    public var action: NYXFilterAction
+
+    public init(id: UUID = UUID(), name: String, enabled: Bool = true, kind: NYXFilterKind = .keyword, pattern: String, action: NYXFilterAction = .hide) {
+        self.id = id; self.name = name; self.enabled = enabled; self.kind = kind; self.pattern = pattern; self.action = action
+    }
+}
+
+public enum NYXFilterValidation: Equatable {
+    case ok
+    case emptyPattern
+    case tooLong
+    case invalidRegex
+}
+
+/// Pure rule matcher. It decides what a rule set would do with a text; wiring that decision into the chat
+/// UI is a separate step.
+public enum NYXMessageFilter {
+    public static let maxPatternLength = 200
+    public static let maxRules = 100
+    public static let maxTextLength = 20_000
+
+    public static func validate(_ rule: NYXFilterRule) -> NYXFilterValidation {
+        let pattern = rule.pattern.trimmingCharacters(in: .whitespacesAndNewlines)
+        if pattern.isEmpty { return .emptyPattern }
+        if pattern.count > maxPatternLength { return .tooLong }
+        if rule.kind == .regex, (try? NSRegularExpression(pattern: pattern, options: [.caseInsensitive])) == nil {
+            return .invalidRegex
+        }
+        return .ok
+    }
+
+    public static func matches(_ rule: NYXFilterRule, in text: String) -> Bool {
+        guard rule.enabled, validate(rule) == .ok else { return false }
+        let text = String(text.prefix(maxTextLength))
+        let pattern = rule.pattern.trimmingCharacters(in: .whitespacesAndNewlines)
+        switch rule.kind {
+        case .keyword:
+            return text.range(of: pattern, options: [.caseInsensitive, .diacriticInsensitive]) != nil
+        case .wholeWord:
+            let escaped = NSRegularExpression.escapedPattern(for: pattern)
+            return text.range(of: "(?<![\\p{L}\\p{N}_])\(escaped)(?![\\p{L}\\p{N}_])", options: [.regularExpression, .caseInsensitive]) != nil
+        case .regex:
+            guard let regex = try? NSRegularExpression(pattern: pattern, options: [.caseInsensitive]) else { return false }
+            return regex.firstMatch(in: text, options: [], range: NSRange(text.startIndex..., in: text)) != nil
+        }
+    }
+
+    /// Strongest action among matching rules: hide > mute > highlight. Nil when nothing matches.
+    public static func decide(_ rules: [NYXFilterRule], text: String) -> (action: NYXFilterAction, rule: NYXFilterRule)? {
+        let order: [NYXFilterAction] = [.hide, .mute, .highlight]
+        var best: (NYXFilterAction, NYXFilterRule)?
+        for rule in rules.prefix(maxRules) where matches(rule, in: text) {
+            if best == nil || order.firstIndex(of: rule.action)! < order.firstIndex(of: best!.0)! {
+                best = (rule.action, rule)
+            }
+        }
+        return best.map { (action: $0.0, rule: $0.1) }
+    }
+}
diff --git a/Ghostgram/Features/NYXToolkit/Core/NYXRedactor.swift b/Ghostgram/Features/NYXToolkit/Core/NYXRedactor.swift
new file mode 100644
index 00000000..4c14d033
--- /dev/null
+++ b/Ghostgram/Features/NYXToolkit/Core/NYXRedactor.swift
@@ -0,0 +1,57 @@
+import Foundation
+
+public struct NYXRedactionOptions: Codable, Equatable {
+    public var phones = true
+    public var emails = true
+    public var links = true
+    public var cardNumbers = true
+    public var usernames = false
+    public init() {}
+}
+
+/// Masks sensitive-looking text for Streamer Mode. Purely textual: it works on strings it is given.
+public enum NYXRedactor {
+    public static let mask = "••••"
+
+    public static func redact(_ text: String, options: NYXRedactionOptions = NYXRedactionOptions()) -> String {
+        var result = text
+        // Order matters: links and emails first so their digits/@ are not re-matched.
+        if options.links { result = replace(result, #"(?i)\b(?:https?://|www\.|t\.me/)[^\s<>"']+"#) }
+        if options.emails { result = replace(result, #"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}"#) }
+        if options.cardNumbers { result = replaceCards(result) }
+        if options.phones { result = replace(result, #"(?<![\w])\+?\d[\d\-\s().]{8,16}\d(?![\w])"#) }
+        if options.usernames { result = replace(result, #"(?<![\w@])@[A-Za-z][A-Za-z0-9_]{4,31}"#) }
+        return result
+    }
+
+    private static func replace(_ text: String, _ pattern: String) -> String {
+        guard let regex = try? NSRegularExpression(pattern: pattern, options: []) else { return text }
+        return regex.stringByReplacingMatches(in: text, options: [], range: NSRange(text.startIndex..., in: text), withTemplate: mask)
+    }
+
+    /// 13–19 digits (spaces/dashes allowed) that pass the Luhn check.
+    private static func replaceCards(_ text: String) -> String {
+        guard let regex = try? NSRegularExpression(pattern: #"(?<!\d)(?:\d[ \-]?){12,18}\d(?!\d)"#, options: []) else { return text }
+        let ns = text as NSString
+        var result = text as String
+        for match in regex.matches(in: text, options: [], range: NSRange(location: 0, length: ns.length)).reversed() {
+            let candidate = ns.substring(with: match.range)
+            let digits = candidate.filter { $0.isNumber }
+            if luhn(digits), let range = Range(match.range, in: result) {
+                result.replaceSubrange(range, with: mask)
+            }
+        }
+        return result
+    }
+
+    static func luhn(_ digits: String) -> Bool {
+        guard digits.count >= 13, digits.count <= 19 else { return false }
+        var sum = 0
+        for (index, char) in digits.reversed().enumerated() {
+            guard var value = char.wholeNumberValue else { return false }
+            if index % 2 == 1 { value *= 2; if value > 9 { value -= 9 } }
+            sum += value
+        }
+        return sum % 10 == 0
+    }
+}
diff --git a/Ghostgram/Features/NYXToolkit/Core/NYXToolkitPrefs.swift b/Ghostgram/Features/NYXToolkit/Core/NYXToolkitPrefs.swift
