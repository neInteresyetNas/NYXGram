@@ -0,0 +1,113 @@
+import XCTest
+@testable import GGNYXToolkitCore
+
+final class NYXToolkitTests: XCTestCase {
+    private func tempURL() -> URL {
+        return FileManager.default.temporaryDirectory.appendingPathComponent("nyx-toolkit-\(UUID().uuidString)/f.json")
+    }
+
+    // MARK: filters
+    func testKeywordIsCaseAndDiacriticInsensitive() {
+        let rule = NYXFilterRule(name: "r", pattern: "cafe")
+        XCTAssertTrue(NYXMessageFilter.matches(rule, in: "Nice CAFÉ here"))
+        XCTAssertFalse(NYXMessageFilter.matches(rule, in: "tea"))
+    }
+
+    func testWholeWordDoesNotMatchInsideWords() {
+        let rule = NYXFilterRule(name: "r", kind: .wholeWord, pattern: "cat")
+        XCTAssertTrue(NYXMessageFilter.matches(rule, in: "a cat sat"))
+        XCTAssertFalse(NYXMessageFilter.matches(rule, in: "category"))
+        XCTAssertTrue(NYXMessageFilter.matches(NYXFilterRule(name: "r", kind: .wholeWord, pattern: "c++"), in: "I like c++ a lot"))
+    }
+
+    func testInvalidRegexIsRejectedAndNeverMatches() {
+        let rule = NYXFilterRule(name: "r", kind: .regex, pattern: "([")
+        XCTAssertEqual(NYXMessageFilter.validate(rule), .invalidRegex)
+        XCTAssertFalse(NYXMessageFilter.matches(rule, in: "(["))
+    }
+
+    func testValidationLimits() {
+        XCTAssertEqual(NYXMessageFilter.validate(NYXFilterRule(name: "r", pattern: "  ")), .emptyPattern)
+        XCTAssertEqual(NYXMessageFilter.validate(NYXFilterRule(name: "r", pattern: String(repeating: "a", count: 201))), .tooLong)
+    }
+
+    func testDisabledRuleDoesNotMatch() {
+        XCTAssertFalse(NYXMessageFilter.matches(NYXFilterRule(name: "r", enabled: false, pattern: "x"), in: "x"))
+    }
+
+    func testStrongestActionWins() {
+        let rules = [
+            NYXFilterRule(name: "a", pattern: "spam", action: .highlight),
+            NYXFilterRule(name: "b", pattern: "spam", action: .hide),
+            NYXFilterRule(name: "c", pattern: "spam", action: .mute)
+        ]
+        XCTAssertEqual(NYXMessageFilter.decide(rules, text: "spam")?.action, .hide)
+        XCTAssertNil(NYXMessageFilter.decide(rules, text: "ok"))
+    }
+
+    // MARK: redactor
+    func testRedactsEmailLinkAndPhone() {
+        let text = "mail me a.b@example.com or see https://example.com/x?y=1 call +49 151 2345 6789"
+        let out = NYXRedactor.redact(text)
+        XCTAssertFalse(out.contains("example.com"))
+        XCTAssertFalse(out.contains("2345"))
+        XCTAssertTrue(out.contains(NYXRedactor.mask))
+        XCTAssertTrue(out.hasPrefix("mail me"))
+    }
+
+    func testCardNumbersNeedLuhn() {
+        XCTAssertFalse(NYXRedactor.redact("pay 4242 4242 4242 4242 now", options: onlyCards()).contains("4242"))
+        XCTAssertTrue(NYXRedactor.redact("id 1234 5678 9012 3456", options: onlyCards()).contains("1234"))
+    }
+
+    func testOptionsCanBeSwitchedOff() {
+        var options = NYXRedactionOptions()
+        options.emails = false
+        XCTAssertTrue(NYXRedactor.redact("a@b.com", options: options).contains("a@b.com"))
+        options.usernames = true
+        XCTAssertFalse(NYXRedactor.redact("ping @someone_1 please", options: options).contains("someone"))
+    }
+
+    private func onlyCards() -> NYXRedactionOptions {
+        var o = NYXRedactionOptions()
+        o.phones = false; o.emails = false; o.links = false
+        return o
+    }
+
+    // MARK: event log + json file
+    func testEventLogIsCappedAndNewestFirst() {
+        let log = NYXEventLog(url: self.tempURL())
+        for i in 0..<(NYXEventLog.maxEvents + 5) { log.record(source: "t", "e\(i)") }
+        XCTAssertEqual(log.events.count, NYXEventLog.maxEvents)
+        XCTAssertEqual(log.query().first?.text, "e\(NYXEventLog.maxEvents + 4)")
+    }
+
+    func testEventTextIsCutAndSearchWorks() {
+        let log = NYXEventLog(url: self.tempURL())
+        log.record(.warning, source: "Gifts", String(repeating: "x", count: 1000))
+        log.record(source: "Import", "restored")
+        XCTAssertEqual(log.events.first?.text.count, NYXEventLog.maxTextLength)
+        XCTAssertEqual(log.query(severity: .warning).count, 1)
+        XCTAssertEqual(log.query(search: "REST").count, 1)
+    }
+
+    func testPersistenceAndCorruptionRecovery() throws {
+        let url = self.tempURL()
+        let log = NYXEventLog(url: url)
+        log.record(source: "a", "one")
+        log.record(source: "a", "two")
+        try Data("broken".utf8).write(to: url)
+        let reloaded = NYXEventLog(url: url)
+        XCTAssertTrue(reloaded.wasRecovered)
+        XCTAssertEqual(reloaded.events.count, 1)   // restored from the backup of the previous good save
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: url.deletingLastPathComponent().path)) ?? []
+        XCTAssertTrue(names.contains(where: { $0.contains("corrupt-") }))
+    }
+
+    func testStoreRejectsInvalidRules() {
+        let store = NYXToolkitStore(url: self.tempURL())
+        XCTAssertEqual(store.addRule(NYXFilterRule(name: "r", kind: .regex, pattern: "([")), .invalidRegex)
+        XCTAssertEqual(store.addRule(NYXFilterRule(name: "r", pattern: "ok")), .ok)
+        XCTAssertEqual(store.prefs.filterRules.count, 1)
+    }
+}
diff --git a/Ghostgram/Features/NYXTools/Core/NYXJSONFileStore.swift b/Ghostgram/Features/NYXTools/Core/NYXJSONFileStore.swift
new file mode 100644
index 00000000..24df0d30
--- /dev/null
+++ b/Ghostgram/Features/NYXTools/Core/NYXJSONFileStore.swift
@@ -0,0 +1,85 @@
+import Foundation
+
+public enum NYXStoreIssue: Equatable {
+    case restoredFromBackup
+    case resetAfterCorruption
+}
+
+/// One Codable value in one JSON file: atomic writes, previous good file kept as `.bak`, a damaged file is
+/// restored from the backup or set aside as `.corrupt-<time>` (never silently deleted).
+public final class NYXJSONFileStore<Value: Codable & Equatable> {
+    private let fileURL: URL
+    private let lock = NSLock()
+    private var value: Value
+    public private(set) var loadIssue: NYXStoreIssue?
+
+    public init(fileURL: URL, defaultValue: Value) {
+        self.fileURL = fileURL
+        self.value = defaultValue
+        try? FileManager.default.createDirectory(at: fileURL.deletingLastPathComponent(), withIntermediateDirectories: true, attributes: nil)
+        self.load(defaultValue)
+    }
+
+    public var current: Value {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.value
+    }
+
+    /// `normalize` runs after every change (caps, clean-up).
+    public func update(normalize: (inout Value) -> Void = { _ in }, _ change: (inout Value) -> Void) {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        var next = self.value
+        change(&next)
+        normalize(&next)
+        if next != self.value {
+            self.value = next
+            self.save()
+        }
+    }
+
+    private var backupURL: URL { return self.fileURL.appendingPathExtension("bak") }
+
+    private func read(_ url: URL) -> Value? {
+        guard let data = try? Data(contentsOf: url) else { return nil }
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        return try? decoder.decode(Value.self, from: data)
+    }
+
+    private func load(_ defaultValue: Value) {
+        let fm = FileManager.default
+        if fm.fileExists(atPath: self.fileURL.path) {
+            if let main = self.read(self.fileURL) {
+                self.value = main
+                return
+            }
+            let stamp = Int(Date().timeIntervalSince1970)
+            try? fm.moveItem(at: self.fileURL, to: self.fileURL.appendingPathExtension("corrupt-\(stamp)"))
+            if let backup = self.read(self.backupURL) {
+                self.value = backup
+                self.loadIssue = .restoredFromBackup
+                self.save()
+            } else {
+                self.loadIssue = .resetAfterCorruption
+            }
+        } else if let backup = self.read(self.backupURL) {
+            self.value = backup
+            self.loadIssue = .restoredFromBackup
+        }
+    }
+
+    private func save() {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        encoder.dateEncodingStrategy = .iso8601
+        guard let data = try? encoder.encode(self.value) else { return }
+        let fm = FileManager.default
+        if fm.fileExists(atPath: self.fileURL.path), self.read(self.fileURL) != nil {
+            try? fm.removeItem(at: self.backupURL)
+            try? fm.copyItem(at: self.fileURL, to: self.backupURL)
+        }
+        try? data.write(to: self.fileURL, options: [.atomic])
+    }
+}
diff --git a/Ghostgram/Features/NYXTools/Core/NYXLogic.swift b/Ghostgram/Features/NYXTools/Core/NYXLogic.swift
new file mode 100644
index 00000000..6aa7b3fc
--- /dev/null
+++ b/Ghostgram/Features/NYXTools/Core/NYXLogic.swift
@@ -0,0 +1,111 @@
+import Foundation
+
+// MARK: Filter engine
+
+public enum NYXFilterEngine {
+    /// nil when the pattern is valid, otherwise a short reason.
+    public static func validate(_ rule: NYXFilterRule) -> String? {
+        if rule.pattern.isEmpty { return "empty" }
+        if rule.pattern.count > NYXToolsPrefs.maxPatternLength { return "too long" }
+        if rule.isRegex, (try? NSRegularExpression(pattern: rule.pattern, options: [])) == nil { return "invalid regex" }
+        return nil
+    }
+
+    public static func matches(_ rule: NYXFilterRule, in text: String) -> Bool {
+        guard rule.enabled, validate(rule) == nil else { return false }
+        if rule.isRegex {
+            let options: NSRegularExpression.Options = rule.caseSensitive ? [] : [.caseInsensitive]
+            guard let regex = try? NSRegularExpression(pattern: rule.pattern, options: options) else { return false }
+            // Long inputs are cut so a heavy pattern can not stall the UI.
+            let sample = String(text.prefix(5000))
+            return regex.firstMatch(in: sample, options: [], range: NSRange(sample.startIndex..., in: sample)) != nil
+        }
+        return rule.caseSensitive ? text.contains(rule.pattern) : text.range(of: rule.pattern, options: .caseInsensitive) != nil
+    }
+
+    /// Rules that match, in list order.
+    public static func matching(_ rules: [NYXFilterRule], text: String) -> [NYXFilterRule] {
+        return rules.filter { NYXFilterEngine.matches($0, in: text) }
+    }
+
+    /// The strongest action among the matches: hide > mute > highlight.
+    public static func decision(_ rules: [NYXFilterRule], text: String) -> NYXFilterAction? {
+        let actions = Set(NYXFilterEngine.matching(rules, text: text).map { $0.action })
+        for action in [NYXFilterAction.hide, .mute, .highlight] where actions.contains(action) { return action }
+        return nil
+    }
+}
+
+// MARK: Redaction (Streamer mode preview and a "copy safe text" tool)
+
+public struct NYXRedactionOptions: Codable, Equatable {
+    public var phones = true
+    public var emails = true
+    public var cards = true
+    public var links = false
+    public init() {}
+}
+
+public enum NYXRedactor {
+    private static func regex(_ pattern: String) -> NSRegularExpression? {
+        return try? NSRegularExpression(pattern: pattern, options: [])
+    }
+
+    public static func redact(_ text: String, options: NYXRedactionOptions) -> String {
+        var result = text
+        if options.cards { result = NYXRedactor.maskCards(result) }
+        if options.emails { result = NYXRedactor.replace(result, pattern: "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", with: "•••@•••") }
+        if options.links { result = NYXRedactor.replace(result, pattern: "(https?://|t\\.me/)[^\\s]+", with: "[link hidden]") }
+        if options.phones { result = NYXRedactor.replace(result, pattern: "\\+?\\d[\\d\\s().-]{7,}\\d", with: "+••• ••• ••••") }
+        return result
+    }
+
+    private static func replace(_ text: String, pattern: String, with template: String) -> String {
+        guard let regex = NYXRedactor.regex(pattern) else { return text }
+        return regex.stringByReplacingMatches(in: text, options: [], range: NSRange(text.startIndex..., in: text), withTemplate: NSRegularExpression.escapedTemplate(for: template))
+    }
+
+    /// Card numbers: 13–19 digits (spaces/dashes allowed) that pass the Luhn check.
+    private static func maskCards(_ text: String) -> String {
+        guard let regex = NYXRedactor.regex("\\b(?:\\d[ -]?){12,18}\\d\\b") else { return text }
+        var result = text
+        let matches = regex.matches(in: text, options: [], range: NSRange(text.startIndex..., in: text))
+        for match in matches.reversed() {
+            guard let range = Range(match.range, in: result) else { continue }
+            let digits = result[range].filter { $0.isNumber }
+            if (13...19).contains(digits.count), luhn(String(digits)) {
+                result.replaceSubrange(range, with: "•••• •••• •••• " + digits.suffix(4))
+            }
+        }
+        return result
+    }
+
+    static func luhn(_ digits: String) -> Bool {
+        var sum = 0
+        for (index, character) in digits.reversed().enumerated() {
+            guard var value = character.wholeNumberValue else { return false }
+            if index % 2 == 1 {
+                value *= 2
+                if value > 9 { value -= 9 }
+            }
+            sum += value
+        }
+        return sum % 10 == 0
+    }
+}
+
+// MARK: Templates
+
+public enum NYXTemplateRenderer {
+    /// Replaces {date}, {time}, {weekday} and {name}. Unknown placeholders stay as they are.
+    public static func render(_ body: String, now: Date, name: String = "", calendar: Calendar = .current, locale: Locale = .current) -> String {
+        let date = DateFormatter(); date.locale = locale; date.calendar = calendar; date.dateStyle = .medium; date.timeStyle = .none
+        let time = DateFormatter(); time.locale = locale; time.calendar = calendar; time.dateStyle = .none; time.timeStyle = .short
+        let weekday = DateFormatter(); weekday.locale = locale; weekday.calendar = calendar; weekday.dateFormat = "EEEE"
+        return body
+            .replacingOccurrences(of: "{date}", with: date.string(from: now))
+            .replacingOccurrences(of: "{time}", with: time.string(from: now))
+            .replacingOccurrences(of: "{weekday}", with: weekday.string(from: now))
+            .replacingOccurrences(of: "{name}", with: name)
+    }
+}
