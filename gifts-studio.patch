+
+final class NYXGiftQueryTests: XCTestCase {
+    private func own(_ key: String, title: String, order: Int, saved: Bool = true, pinned: Bool = false, date: Int32 = 0, price: Int64? = nil, total: Int32? = nil, kind: NYXGiftKind = .regular) -> NYXGiftItem {
+        return NYXGiftItem(id: "own:\(key)", title: title, kind: kind, priceStars: price, total: total, order: order, ownership: NYXGiftOwnership(referenceKey: key, savedToProfile: saved, pinnedToTop: pinned, date: date, fromName: nil))
+    }
+
+    func testSearchIsCaseInsensitiveAndMatchesAttributes() {
+        let a = NYXGiftItem(id: "gift:1", title: "Plush Pepe", kind: .unique, number: 7, attributes: ["Neon"], order: 0)
+        let b = NYXGiftItem(id: "gift:2", title: "Heart", kind: .regular, order: 1)
+        var filter = NYXGiftFilter()
+        filter.search = "pepe"
+        XCTAssertEqual(NYXGiftQuery.apply([a, b], filter: filter, sort: .name, favorites: []).map { $0.id }, ["gift:1"])
+        filter.search = "NEON"
+        XCTAssertEqual(NYXGiftQuery.apply([a, b], filter: filter, sort: .name, favorites: []).count, 1)
+        filter.search = "#7"
+        XCTAssertEqual(NYXGiftQuery.apply([a, b], filter: filter, sort: .name, favorites: []).count, 1)
+    }
+
+    func testVisibilityAndPinnedFilters() {
+        let shown = own("a", title: "A", order: 0)
+        let hidden = own("b", title: "B", order: 1, saved: false)
+        let pinned = own("c", title: "C", order: 2, pinned: true)
+        var filter = NYXGiftFilter()
+        filter.visibility = .hidden
+        XCTAssertEqual(NYXGiftQuery.apply([shown, hidden, pinned], filter: filter, sort: .name, favorites: []).map { $0.title }, ["B"])
+        filter.visibility = .shown
+        XCTAssertEqual(NYXGiftQuery.apply([shown, hidden, pinned], filter: filter, sort: .name, favorites: []).count, 2)
+        filter = NYXGiftFilter(onlyPinned: true)
+        XCTAssertEqual(NYXGiftQuery.apply([shown, hidden, pinned], filter: filter, sort: .name, favorites: []).map { $0.title }, ["C"])
+    }
+
+    func testFavoritesUseStorageKey() {
+        let a = own("k1", title: "A", order: 0)
+        let b = own("k2", title: "B", order: 1)
+        let filter = NYXGiftFilter(onlyFavorites: true)
+        XCTAssertEqual(NYXGiftQuery.apply([a, b], filter: filter, sort: .name, favorites: ["k2"]).map { $0.title }, ["B"])
+    }
+
+    func testNilValuesSortLastInBothDirections() {
+        let a = own("a", title: "A", order: 0, price: nil)
+        let b = own("b", title: "B", order: 1, price: 10)
+        let c = own("c", title: "C", order: 2, price: 5)
+        XCTAssertEqual(NYXGiftQuery.sorted([a, b, c], by: .priceLow).map { $0.title }, ["C", "B", "A"])
+        XCTAssertEqual(NYXGiftQuery.sorted([a, b, c], by: .priceHigh).map { $0.title }, ["B", "C", "A"])
+    }
+
+    func testNewestAndScarcestAreDeterministic() {
+        let a = own("a", title: "A", order: 0, date: 5, total: 100)
+        let b = own("b", title: "B", order: 1, date: 5, total: 10)
+        let c = own("c", title: "C", order: 2, date: 9, total: nil)
+        XCTAssertEqual(NYXGiftQuery.sorted([a, b, c], by: .newest).map { $0.title }, ["C", "A", "B"])
+        XCTAssertEqual(NYXGiftQuery.sorted([a, b, c], by: .scarcest).map { $0.title }, ["B", "A", "C"])
+    }
+
+    func testMove() {
+        XCTAssertEqual(NYXListMove.move([1, 2, 3, 4], from: 0, to: 2), [2, 3, 1, 4])
+        XCTAssertEqual(NYXListMove.move([1, 2, 3, 4], from: 3, to: 0), [4, 1, 2, 3])
+        XCTAssertEqual(NYXListMove.move([1, 2, 3], from: 5, to: 0), [1, 2, 3])
+        XCTAssertEqual(NYXListMove.move([1, 2, 3], from: 1, to: 1), [1, 2, 3])
+    }
+
+    func testCompositionVisibleKeysPutPrimaryFirstAndRespectMax() {
+        let composition = NYXProfileComposition(name: "x", giftKeys: ["a", "b", "c", "d"], primaryKey: "c", maxItems: 3)
+        XCTAssertEqual(composition.visibleKeys, ["c", "a", "b"])
+    }
+
+    func testCompositionClampsColumnsAndMax() {
+        let composition = NYXProfileComposition(name: "x", columns: 99, maxItems: 0)
+        XCTAssertEqual(composition.columns, 4)
+        XCTAssertEqual(composition.maxItems, 1)
+    }
+}
diff --git a/Ghostgram/Features/GiftsStudio/Tests/NYXGiftsStoreTests.swift b/Ghostgram/Features/GiftsStudio/Tests/NYXGiftsStoreTests.swift
new file mode 100644
index 00000000..bb62d7c0
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/Tests/NYXGiftsStoreTests.swift
@@ -0,0 +1,119 @@
+import XCTest
+@testable import GGGiftsStudioCore
+
+final class NYXGiftsStoreTests: XCTestCase {
+    private var directory: URL!
+
+    override func setUp() {
+        super.setUp()
+        self.directory = FileManager.default.temporaryDirectory.appendingPathComponent("nyx-gifts-tests-\(UUID().uuidString)", isDirectory: true)
+        try? FileManager.default.createDirectory(at: self.directory, withIntermediateDirectories: true, attributes: nil)
+    }
+
+    override func tearDown() {
+        try? FileManager.default.removeItem(at: self.directory)
+        super.tearDown()
+    }
+
+    private var file: URL { return self.directory.appendingPathComponent("prefs.json") }
+
+    func testPersistsAcrossInstances() {
+        let store = NYXGiftsStore(fileURL: self.file)
+        store.update { $0.favorites = ["a", "b"]; $0.notes["a"] = "hello" }
+        let reloaded = NYXGiftsStore(fileURL: self.file)
+        XCTAssertEqual(reloaded.current.favorites, ["a", "b"])
+        XCTAssertEqual(reloaded.current.notes["a"], "hello")
+        XCTAssertNil(reloaded.loadIssue)
+    }
+
+    func testSecondSaveCreatesBackup() {
+        let store = NYXGiftsStore(fileURL: self.file)
+        store.update { $0.favorites = ["a"] }
+        store.update { $0.favorites = ["a", "b"] }
+        XCTAssertTrue(FileManager.default.fileExists(atPath: self.file.appendingPathExtension("bak").path))
+    }
+
+    func testCorruptMainFileRestoresBackup() throws {
+        let store = NYXGiftsStore(fileURL: self.file)
+        store.update { $0.favorites = ["a"] }
+        store.update { $0.favorites = ["a", "b"] }
+        try Data("not json".utf8).write(to: self.file)
+        let reloaded = NYXGiftsStore(fileURL: self.file)
+        XCTAssertEqual(reloaded.loadIssue, .restoredFromBackup)
+        XCTAssertEqual(reloaded.current.favorites, ["a"])
+    }
+
+    func testCorruptWithoutBackupResetsAndKeepsDamagedFile() throws {
+        try Data("garbage".utf8).write(to: self.file)
+        let store = NYXGiftsStore(fileURL: self.file)
+        XCTAssertEqual(store.loadIssue, .resetAfterCorruption)
+        XCTAssertEqual(store.current, NYXGiftsPrefs())
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: self.directory.path)) ?? []
+        XCTAssertTrue(names.contains(where: { $0.contains("corrupt-") }))
+    }
+
+    func testNewerSchemaIsReadOnlyAndFileIsUntouched() throws {
+        var newer = NYXGiftsPrefs()
+        newer.schemaVersion = NYXGiftsPrefs.currentVersion + 1
+        newer.favorites = ["x"]
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        let original = try encoder.encode(newer)
+        try original.write(to: self.file)
+        let store = NYXGiftsStore(fileURL: self.file)
+        XCTAssertEqual(store.loadIssue, .newerVersionReadOnly)
+        store.update { $0.favorites = ["changed"] }
+        XCTAssertEqual(try Data(contentsOf: self.file), original)
+    }
+
+    func testExportImportRoundTrip() throws {
+        let store = NYXGiftsStore(fileURL: self.file)
+        store.update { $0.favorites = ["a"]; $0.compositions = [NYXProfileComposition(name: "L", giftKeys: ["a"])] }
+        let data = try XCTUnwrap(store.exportData())
+        let other = NYXGiftsStore(fileURL: self.directory.appendingPathComponent("other.json"))
+        try other.importData(data)
+        XCTAssertEqual(other.current.favorites, ["a"])
+        XCTAssertEqual(other.current.compositions.first?.name, "L")
+    }
+
+    func testImportRejectsGarbageAndNewerVersions() throws {
+        let store = NYXGiftsStore(fileURL: self.file)
+        XCTAssertThrowsError(try store.importData(Data("nope".utf8))) { XCTAssertEqual($0 as? NYXGiftsImportError, .notValidData) }
+        var newer = NYXGiftsPrefs()
+        newer.schemaVersion = 99
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        let data = try encoder.encode(newer)
+        XCTAssertThrowsError(try store.importData(data)) { XCTAssertEqual($0 as? NYXGiftsImportError, .newerVersion) }
+    }
+
+    func testLimitsAreEnforced() {
+        let store = NYXGiftsStore(fileURL: self.file)
+        store.update { prefs in
+            prefs.notes["a"] = String(repeating: "x", count: NYXGiftsPrefs.maxNoteLength + 50)
+            prefs.favorites = ["a", "a", "b"]
+            for i in 0..<(NYXGiftsPrefs.maxChangeLog + 20) {
+                prefs.changeLog.append(NYXChangeEntry(date: Date(timeIntervalSince1970: Double(i)), text: "\(i)"))
+            }
+        }
+        XCTAssertEqual(store.current.notes["a"]?.count, NYXGiftsPrefs.maxNoteLength)
+        XCTAssertEqual(store.current.favorites, ["a", "b"])
+        XCTAssertEqual(store.current.changeLog.count, NYXGiftsPrefs.maxChangeLog)
+        XCTAssertEqual(store.current.changeLog.last?.text, "\(NYXGiftsPrefs.maxChangeLog + 19)")
+    }
+
+    func testActiveCompositionClearedWhenDeleted() {
+        let store = NYXGiftsStore(fileURL: self.file)
+        let composition = NYXProfileComposition(name: "L")
+        store.update { $0.compositions = [composition]; $0.activeCompositionID = composition.id }
+        store.update { $0.compositions = [] }
+        XCTAssertNil(store.current.activeCompositionID)
+    }
+
+    func testResetKeepsBackupOfPreviousData() {
+        let store = NYXGiftsStore(fileURL: self.file)
+        store.update { $0.favorites = ["a"] }
+        store.resetAll()
+        XCTAssertTrue(store.current.favorites.isEmpty)
+    }
+}
