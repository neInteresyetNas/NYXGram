+import Foundation
+import SwiftUI
+import UIKit
+import GGCore
+import GGSettingsUI
+
+/// Entry point of Gifts Studio. Adds one action row to the «More» screen of the NYXGram menu; nothing
+/// runs until the user opens it.
+public enum GGGiftsStudioModule {
+    static let section = GGMenuSectionID("giftsStudio.main")
+
+    /// Called once on the main thread from `GGFeatures.registerAll()`, before `GGHookRegistry.freeze()`.
+    public static func register() {
+        GGMenuRegistry.register(section: GGMenuSectionDescriptor(id: GGGiftsStudioModule.section, screen: .category(.more), order: 50))
+        GGMenuRegistry.register(GGMenuRow(
+            id: "giftsStudio.open",
+            section: GGGiftsStudioModule.section,
+            order: 100,
+            title: { nyxT("Gifts Studio", "Gifts Studio") },
+            subtitle: { nyxT("Catalog, your collection and profile layouts. Never buys or sends gifts.", "Каталог, ваша коллекция и раскладки профиля. Ничего не покупает и не отправляет.") },
+            icon: .system("gift"),
+            kind: .action({ context in
+                GGGiftsStudioModule.open(context)
+            }),
+            searchKeywords: { ["gifts", "подарки", "collection", "коллекция", "stars"] }
+        ))
+    }
+
+    private static func open(_ menuContext: GGMenuContext) {
+        let model = NYXGiftsViewModel(context: menuContext.context)
+        var controller: UIHostingController<NYXGiftsRootView>?
+        let root = NYXGiftsRootView(model: model, close: {
+            controller?.dismiss(animated: true, completion: nil)
+        })
+        let hosting = UIHostingController(rootView: root)
+        hosting.modalPresentationStyle = .pageSheet
+        controller = hosting
+        menuContext.presentNative(hosting)
+    }
+}
diff --git a/Ghostgram/Features/GiftsStudio/Sources/NYXGiftsService.swift b/Ghostgram/Features/GiftsStudio/Sources/NYXGiftsService.swift
new file mode 100644
index 00000000..4c942aa2
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/Sources/NYXGiftsService.swift
@@ -0,0 +1,241 @@
+import Foundation
+import SwiftSignalKit
+import Postbox
+import TelegramCore
+import AccountContext
+import GGGiftsStudioCore
+
+/// Reads the real Telegram gift data (catalog and the user's own collection) and maps it to the pure
+/// models of `GGGiftsStudioCore`.
+///
+/// What this service is allowed to change on Telegram (always after the user confirms in the UI):
+///  - show / hide a gift on the profile,
+///  - pin / unpin a gift,
+///  - the order of the pinned gifts.
+/// It deliberately has NO code path for buying, sending, transferring, converting to Stars,
+/// withdrawing, upgrading, reselling or deleting gifts. `Scripts/check-gifts-forbidden.sh` enforces that.
+final class NYXGiftsService {
+    private let context: AccountContext
+    private let profileGifts: ProfileGiftsContext
+    private let referenceLock = NSLock()
+    private var references: [String: StarGiftReference] = [:]
+
+    init(context: AccountContext) {
+        self.context = context
+        self.profileGifts = ProfileGiftsContext(account: context.account, peerId: context.account.peerId)
+    }
+
+    /// Pin limit from Telegram's app config; 6 when the config has none.
+    var maxPinned: Int {
+        if let value = self.context.currentAppConfiguration.with({ $0 }).data?["stargifts_pinned_to_top_limit"] as? Double {
+            return max(1, Int(value))
+        }
+        return 6
+    }
+
+    // MARK: Catalog
+
+    /// Keeps Telegram's gift catalog fresh while the returned signal is subscribed.
+    func keepCatalogUpdated() -> Signal<Never, NoError> {
+        return self.context.engine.payments.keepStarGiftsUpdated()
+    }
+
+    /// Catalog from Telegram's cache.
+    func catalog() -> Signal<[NYXGiftItem], NoError> {
+        return self.context.engine.payments.cachedStarGifts()
+        |> map { gifts -> [NYXGiftItem] in
+            guard let gifts = gifts else {
+                return []
+            }
+            var result: [NYXGiftItem] = []
+            for (index, gift) in gifts.enumerated() {
+                if let item = NYXGiftsService.catalogItem(gift, order: index) {
+                    result.append(item)
+                }
+            }
+            return result
+        }
+    }
+
+    private static func catalogItem(_ gift: StarGift, order: Int) -> NYXGiftItem? {
+        switch gift {
+        case let .generic(gift):
+            let limited = gift.availability != nil
+            return NYXGiftItem(
+                id: "gift:\(gift.id)",
+                title: gift.title ?? "",
+                kind: limited ? .limited : .regular,
+                priceStars: gift.price,
+                remains: gift.availability?.remains,
+                total: gift.availability?.total,
+                requiresPremium: gift.flags.contains(.requiresPremium),
+                isBirthday: gift.flags.contains(.isBirthdayGift),
+                thumbnail: gift.file.immediateThumbnailData,
+                order: order
+            )
+        case let .unique(gift):
+            return NYXGiftsService.uniqueItem(id: "gift:\(gift.id)", gift: gift, order: order, ownership: nil)
+        }
+    }
+
+    private static func uniqueItem(id: String, gift: StarGift.UniqueGift, order: Int, ownership: NYXGiftOwnership?) -> NYXGiftItem {
+        var names: [String] = []
+        var rarity: String?
+        var thumbnail: Data?
+        for attribute in gift.attributes {
+            switch attribute {
+            case let .model(name, file, attributeRarity, _):
+                names.append(name)
+                thumbnail = file.immediateThumbnailData
+                rarity = NYXGiftsService.rarityText(attributeRarity)
+            case let .pattern(name, _, _):
+                names.append(name)
+            case let .backdrop(name, _, _, _, _, _, _):
+                names.append(name)
+            case .originalInfo:
+                break
+            }
+        }
+        return NYXGiftItem(
+            id: id,
+            title: gift.title,
+            kind: .unique,
+            remains: gift.availability.total - gift.availability.issued,
+            total: gift.availability.total,
+            number: gift.number,
+            rarity: rarity,
+            attributes: names,
+            thumbnail: thumbnail,
+            order: order,
+            ownership: ownership
+        )
+    }
+
+    private static func rarityText(_ rarity: StarGift.UniqueGift.Attribute.Rarity) -> String {
+        switch rarity {
+        case let .permille(value):
+            let percent = Double(value) / 10.0
+            return String(format: "%.1f%%", percent)
+        case .uncommon:
+            return "Uncommon"
+        case .rare:
+            return "Rare"
+        case .epic:
+            return "Epic"
+        case .legendary:
+            return "Legendary"
+        }
+    }
+
+    // MARK: Own collection
+
+    func collection() -> Signal<[NYXGiftItem], NoError> {
+        self.profileGifts.reload()
+        return self.profileGifts.state
+        |> map { [weak self] state -> [NYXGiftItem] in
+            guard let self = self else {
+                return []
+            }
+            return self.items(from: state)
+        }
+    }
+
+    func loadMore() {
+        self.profileGifts.loadMore()
+    }
+
+    private func items(from state: ProfileGiftsContext.State) -> [NYXGiftItem] {
+        var result: [NYXGiftItem] = []
+        var map: [String: StarGiftReference] = [:]
+        for (index, entry) in state.gifts.enumerated() {
+            guard let reference = entry.reference else {
+                // Without a reference Telegram cannot be asked to change this gift; it is not listed as manageable.
+                continue
+            }
+            let key = NYXGiftsService.key(for: reference)
+            map[key] = reference
+            let ownership = NYXGiftOwnership(
+                referenceKey: key,
+                savedToProfile: entry.savedToProfile,
+                pinnedToTop: entry.pinnedToTop,
+                date: entry.date,
+                fromName: entry.nameHidden ? nil : entry.fromPeer?.compactDisplayTitle
+            )
+            switch entry.gift {
+            case let .generic(gift):
+                result.append(NYXGiftItem(
+                    id: "own:\(key)",
+                    title: gift.title ?? "",
+                    kind: gift.availability != nil ? .limited : .regular,
+                    priceStars: gift.price,
+                    remains: gift.availability?.remains,
+                    total: gift.availability?.total,
+                    requiresPremium: gift.flags.contains(.requiresPremium),
+                    isBirthday: gift.flags.contains(.isBirthdayGift),
+                    thumbnail: gift.file.immediateThumbnailData,
+                    order: index,
+                    ownership: ownership
+                ))
+            case let .unique(gift):
+                result.append(NYXGiftsService.uniqueItem(id: "own:\(key)", gift: gift, order: index, ownership: ownership))
+            }
+        }
+        self.referenceLock.lock()
+        self.references = map
+        self.referenceLock.unlock()
+        return result
+    }
+
+    /// Stable string for a Telegram reference (used for local notes / favorites and to find the reference again).
+    static func key(for reference: StarGiftReference) -> String {
+        switch reference {
+        case let .message(messageId):
+            return "msg:\(messageId.peerId.toInt64()):\(messageId.namespace):\(messageId.id)"
+        case let .peer(peerId, id):
+            return "peer:\(peerId.toInt64()):\(id)"
+        case let .slug(slug):
+            return "slug:\(slug)"
+        }
+    }
+
+    private func reference(forKey key: String) -> StarGiftReference? {
+        self.referenceLock.lock()
+        defer { self.referenceLock.unlock() }
+        return self.references[key]
+    }
+
+    // MARK: Changes on Telegram (the UI asks the user to confirm before calling these)
+
+    @discardableResult
+    func setShownOnProfile(key: String, shown: Bool) -> Bool {
+        guard let reference = self.reference(forKey: key) else {
+            return false
+        }
+        self.profileGifts.updateStarGiftAddedToProfile(reference: reference, added: shown)
+        return true
+    }
+
+    @discardableResult
+    func setPinned(key: String, pinned: Bool) -> Bool {
+        guard let reference = self.reference(forKey: key) else {
+            return false
+        }
+        self.profileGifts.updateStarGiftPinnedToTop(reference: reference, pinnedToTop: pinned)
+        return true
+    }
+
+    /// Replaces the order of the pinned gifts. Keys that are no longer known are skipped; the list is
+    /// cut to the pin limit. Returns how many were sent.
+    @discardableResult
+    func applyPinnedOrder(keys: [String]) -> Int {
+        var references: [StarGiftReference] = []
+        for key in keys {
+            if let reference = self.reference(forKey: key) {
+                references.append(reference)
+            }
+        }
+        references = Array(references.prefix(self.maxPinned))
+        self.profileGifts.updatePinnedToTopStarGifts(references: references)
+        return references.count
+    }
+}
diff --git a/Ghostgram/Features/GiftsStudio/Sources/NYXGiftsViewModel.swift b/Ghostgram/Features/GiftsStudio/Sources/NYXGiftsViewModel.swift
new file mode 100644
index 00000000..a98a03f8
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/Sources/NYXGiftsViewModel.swift
@@ -0,0 +1,210 @@
+import Foundation
+import SwiftUI
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import GGGiftsStudioCore
+
+/// Small helper: Russian when the device language is Russian, English otherwise.
+func nyxT(_ en: String, _ ru: String) -> String {
+    return Locale.preferredLanguages.first?.hasPrefix("ru") == true ? ru : en
+}
+
+final class NYXGiftsViewModel: ObservableObject {
+    @Published var catalog: [NYXGiftItem] = []
+    @Published var collection: [NYXGiftItem] = []
+    @Published var prefs: NYXGiftsPrefs
+    @Published var isCollectionLoaded = false
+    @Published var message: String?
+
+    let service: NYXGiftsService
+    private let store: NYXGiftsStore
+    private let disposables = DisposableSet()
+
+    init(context: AccountContext, store: NYXGiftsStore = NYXGiftsStore.shared) {
+        self.service = NYXGiftsService(context: context)
+        self.store = store
+        self.prefs = store.current
+        if let issue = store.loadIssue {
+            switch issue {
+            case .restoredFromBackup:
+                self.message = nyxT("Settings file was damaged; the backup was restored.", "Файл настроек повреждён, восстановлена резервная копия.")
+            case .resetAfterCorruption:
+                self.message = nyxT("Settings file was damaged and set aside; defaults are used.", "Файл настроек повреждён и отложен, используются значения по умолчанию.")
+            case .newerVersionReadOnly:
+                self.message = nyxT("Settings were saved by a newer version; changes are not saved.", "Настройки сохранены более новой версией; изменения не сохраняются.")
+            }
+        }
+        self.disposables.add(self.service.keepCatalogUpdated().start())
+        self.disposables.add((self.service.catalog() |> deliverOnMainQueue).start(next: { [weak self] items in
+            self?.catalog = items
+        }))
+        self.disposables.add((self.service.collection() |> deliverOnMainQueue).start(next: { [weak self] items in
+            self?.collection = items
+            self?.isCollectionLoaded = true
+        }))
+    }
+
+    deinit {
+        self.disposables.dispose()
+    }
+
+    // MARK: Local prefs
+
+    func update(_ change: @escaping (inout NYXGiftsPrefs) -> Void) {
+        self.store.update(change)
+        self.prefs = self.store.current
+    }
+
+    func log(_ text: String) {
+        self.store.log(text)
+        self.prefs = self.store.current
+    }
+
+    func isFavorite(_ item: NYXGiftItem) -> Bool {
+        return self.prefs.favorites.contains(item.storageKey)
+    }
+
+    func toggleFavorite(_ item: NYXGiftItem) {
+        let key = item.storageKey
+        self.update { prefs in
+            if let index = prefs.favorites.firstIndex(of: key) {
+                prefs.favorites.remove(at: index)
+            } else {
+                prefs.favorites.append(key)
+            }
+        }
+    }
+
+    func note(for item: NYXGiftItem) -> String {
+        return self.prefs.notes[item.storageKey] ?? ""
+    }
+
+    func setNote(_ text: String, for item: NYXGiftItem) {
+        let key = item.storageKey
+        self.update { $0.notes[key] = text }
+    }
+
+    // MARK: Changes on Telegram (the view confirms first)
+
+    func setShown(_ item: NYXGiftItem, shown: Bool) {
+        guard let key = item.ownership?.referenceKey, self.service.setShownOnProfile(key: key, shown: shown) else {
+            return
+        }
+        self.log((shown ? "Shown on profile: " : "Hidden from profile: ") + item.title)
+    }
+
+    func setPinned(_ item: NYXGiftItem, pinned: Bool) {
+        guard let key = item.ownership?.referenceKey, self.service.setPinned(key: key, pinned: pinned) else {
+            return
+        }
+        self.log((pinned ? "Pinned: " : "Unpinned: ") + item.title)
+    }
+
+    func applyActiveOrderToTelegram() -> Int {
+        guard let composition = self.activeComposition else {
+            return 0
+        }
+        let ownKeys = composition.visibleKeys.filter { $0.hasPrefix("msg:") || $0.hasPrefix("peer:") || $0.hasPrefix("slug:") }
+        let sent = self.service.applyPinnedOrder(keys: ownKeys)
+        self.log("Applied pinned order to Telegram (\(sent) gifts) from \"\(composition.name)\"")
+        return sent
+    }
+
+    // MARK: Compositions
+
+    var activeComposition: NYXProfileComposition? {
+        if let id = self.prefs.activeCompositionID, let found = self.prefs.compositions.first(where: { $0.id == id }) {
+            return found
+        }
+        return self.prefs.compositions.first
+    }
+
+    func addComposition(name: String) {
+        let composition = NYXProfileComposition(name: name.isEmpty ? nyxT("My layout", "Моя раскладка") : name)
+        self.update { prefs in
+            prefs.compositions.append(composition)
+            prefs.activeCompositionID = composition.id
+        }
+        self.log("Created layout \"\(composition.name)\"")
+    }
+
+    func deleteActiveComposition() {
+        guard let composition = self.activeComposition else {
+            return
+        }
+        self.update { prefs in
+            prefs.compositions.removeAll { $0.id == composition.id }
+            prefs.activeCompositionID = prefs.compositions.first?.id
+        }
+        self.log("Deleted layout \"\(composition.name)\"")
+    }
+
+    func editActive(_ change: @escaping (inout NYXProfileComposition) -> Void) {
+        guard let composition = self.activeComposition else {
+            return
+        }
+        self.update { prefs in
+            if let index = prefs.compositions.firstIndex(where: { $0.id == composition.id }) {
+                change(&prefs.compositions[index])
+            }
+        }
+    }
+
+    func item(forKey key: String) -> NYXGiftItem? {
+        return self.collection.first(where: { $0.storageKey == key }) ?? self.catalog.first(where: { $0.storageKey == key })
+    }
+
+    // MARK: Backup
+
+    func exportFileURL() -> URL? {
+        guard let data = self.store.exportData() else {
+            return nil
+        }
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent("nyx-gifts-studio.json")
+        do {
+            try data.write(to: url, options: [.atomic])
+            return url
+        } catch {
+            return nil
+        }
+    }
+
+    func importFromClipboard() {
+        guard let text = UIPasteboard.general.string, let data = text.data(using: .utf8) else {
+            self.message = nyxT("The clipboard has no settings text.", "В буфере нет текста настроек.")
+            return
+        }
+        do {
+            try self.store.importData(data)
+            self.prefs = self.store.current
+            self.log("Imported settings")
+            self.message = nyxT("Settings imported.", "Настройки импортированы.")
+        } catch NYXGiftsImportError.newerVersion {
+            self.message = nyxT("These settings come from a newer NYXGram.", "Эти настройки из более новой версии NYXGram.")
+        } catch {
+            self.message = nyxT("Could not import: the text is not valid Gifts Studio settings.", "Не удалось импортировать: это не настройки Gifts Studio.")
+        }
+    }
+
+    func resetLocalData() {
+        self.store.resetAll()
+        self.prefs = self.store.current
+    }
+
+    // MARK: Compare
+
+    /// Differences between two gifts as plain lines (only facts Telegram provided).
+    func compare(_ a: NYXGiftItem, _ b: NYXGiftItem) -> [(String, String, String)] {
+        func s(_ v: Int64?) -> String { return v.map { String($0) } ?? "—" }
+        func i(_ v: Int32?) -> String { return v.map { String($0) } ?? "—" }
+        return [
+            (nyxT("Type", "Тип"), a.kind.rawValue, b.kind.rawValue),
+            (nyxT("Price (Stars)", "Цена (Stars)"), s(a.priceStars), s(b.priceStars)),
+            (nyxT("Supply", "Тираж"), i(a.total), i(b.total)),
+            (nyxT("Remaining", "Осталось"), i(a.remains), i(b.remains)),
+            (nyxT("Number", "Номер"), i(a.number), i(b.number)),
+            (nyxT("Rarity", "Редкость"), a.rarity ?? "—", b.rarity ?? "—")
+        ]
+    }
+}
diff --git a/Ghostgram/Features/GiftsStudio/Sources/NYXGiftsViews.swift b/Ghostgram/Features/GiftsStudio/Sources/NYXGiftsViews.swift
