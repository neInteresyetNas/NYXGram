diff --git a/Ghostgram/Features/GiftsStudio/BUILD b/Ghostgram/Features/GiftsStudio/BUILD
new file mode 100644
index 00000000..d392ea2d
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/BUILD
@@ -0,0 +1,61 @@
+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
+
+# NYXGram Gifts Studio. Two targets:
+#
+#   GGGiftsStudioCore — pure Swift (Foundation only): models, search/filter/sort, the versioned local
+#                       store with backup and corruption handling. No Telegram code, so it is unit-testable.
+#   GGGiftsStudio     — the feature: reads the real Telegram gift data, SwiftUI screens, menu row.
+#
+# Gifts Studio never buys, sends, transfers, converts, withdraws, upgrades or deletes gifts
+# (Scripts/check-gifts-forbidden.sh checks the sources for those calls).
+swift_library(
+    name = "GGGiftsStudioCore",
+    module_name = "GGGiftsStudioCore",
+    srcs = glob([
+        "Core/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
+
+swift_library(
+    name = "GGGiftsStudio",
+    module_name = "GGGiftsStudio",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    deps = [
+        ":GGGiftsStudioCore",
+        "//Ghostgram/GGCore:GGCore",
+        "//Ghostgram/GGHooks:GGHooks",
+        "//Ghostgram/GGSettingsUI:GGSettingsUI",
+        "//submodules/SSignalKit/SwiftSignalKit:SwiftSignalKit",
+        "//submodules/Postbox:Postbox",
+        "//submodules/TelegramCore:TelegramCore",
+        "//submodules/AccountContext:AccountContext",
+        "//submodules/Display:Display",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
+
+swift_test(
+    name = "GGGiftsStudioCoreTests",
+    srcs = glob([
+        "Tests/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    deps = [
+        ":GGGiftsStudioCore",
+    ],
+)
diff --git a/Ghostgram/Features/GiftsStudio/Core/NYXGiftModels.swift b/Ghostgram/Features/GiftsStudio/Core/NYXGiftModels.swift
new file mode 100644
index 00000000..6cc17083
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/Core/NYXGiftModels.swift
@@ -0,0 +1,114 @@
+import Foundation
+
+/// Kinds of gifts as Telegram describes them. Nothing here is invented: a value that Telegram does not
+/// provide stays nil and the UI shows nothing for it.
+public enum NYXGiftKind: String, Codable, CaseIterable {
+    /// Unlimited catalog gift.
+    case regular
+    /// Limited-supply catalog gift.
+    case limited
+    /// Collectible (upgraded) gift.
+    case unique
+}
+
+/// Ownership data of a gift in the user's own collection.
+public struct NYXGiftOwnership: Equatable {
+    /// Stable string for the Telegram reference of this exact gift (see `NYXGiftsService`).
+    public let referenceKey: String
+    public let savedToProfile: Bool
+    public let pinnedToTop: Bool
+    public let date: Int32
+    public let fromName: String?
+
+    public init(referenceKey: String, savedToProfile: Bool, pinnedToTop: Bool, date: Int32, fromName: String?) {
+        self.referenceKey = referenceKey
+        self.savedToProfile = savedToProfile
+        self.pinnedToTop = pinnedToTop
+        self.date = date
+        self.fromName = fromName
+    }
+}
+
+/// One gift, from the catalog or from the user's collection.
+public struct NYXGiftItem: Equatable, Identifiable {
+    /// "gift:<id>" for catalog entries, "own:<referenceKey>" for collection entries.
+    public let id: String
+    public let title: String
+    public let kind: NYXGiftKind
+    /// Catalog price in Stars, when Telegram gives one.
+    public let priceStars: Int64?
+    public let remains: Int32?
+    public let total: Int32?
+    /// Serial number of a collectible.
+    public let number: Int32?
+    /// Rarity text exactly as derived from Telegram's data (permille or Telegram's own rarity name).
+    public let rarity: String?
+    /// Names of the collectible's model, pattern and backdrop, when present.
+    public let attributes: [String]
+    public let requiresPremium: Bool
+    public let isBirthday: Bool
+    /// Tiny blurred preview that ships with the gift file; the real image or animation is not loaded here.
+    public let thumbnail: Data?
+    /// Position in the source list (the order Telegram returned it in).
+    public let order: Int
+    public let ownership: NYXGiftOwnership?
+
+    public init(id: String, title: String, kind: NYXGiftKind, priceStars: Int64? = nil, remains: Int32? = nil, total: Int32? = nil, number: Int32? = nil, rarity: String? = nil, attributes: [String] = [], requiresPremium: Bool = false, isBirthday: Bool = false, thumbnail: Data? = nil, order: Int, ownership: NYXGiftOwnership? = nil) {
+        self.id = id
+        self.title = title
+        self.kind = kind
+        self.priceStars = priceStars
+        self.remains = remains
+        self.total = total
+        self.number = number
+        self.rarity = rarity
+        self.attributes = attributes
+        self.requiresPremium = requiresPremium
+        self.isBirthday = isBirthday
+        self.thumbnail = thumbnail
+        self.order = order
+        self.ownership = ownership
+    }
+
+    /// Key used for local favorites, notes and compositions. For collection entries it is the reference
+    /// key (it identifies the exact gift); for catalog entries it is the catalog id.
+    public var storageKey: String {
+        return self.ownership?.referenceKey ?? self.id
+    }
+}
+
+public enum NYXGiftSort: String, Codable, CaseIterable {
+    case newest
+    case priceLow
+    case priceHigh
+    case name
+    /// Smaller total supply first (supply is the only scarcity measure Telegram provides for every gift).
+    case scarcest
+}
+
+public enum NYXVisibilityFilter: String, Codable, CaseIterable {
+    case all
+    case shown
+    case hidden
+}
+
+public struct NYXGiftFilter: Codable, Equatable {
+    public var search: String
+    /// Empty = all kinds.
+    public var kinds: Set<NYXGiftKind>
+    public var onlyFavorites: Bool
+    public var onlyPinned: Bool
+    public var visibility: NYXVisibilityFilter
+
+    public init(search: String = "", kinds: Set<NYXGiftKind> = [], onlyFavorites: Bool = false, onlyPinned: Bool = false, visibility: NYXVisibilityFilter = .all) {
+        self.search = search
+        self.kinds = kinds
+        self.onlyFavorites = onlyFavorites
+        self.onlyPinned = onlyPinned
+        self.visibility = visibility
+    }
+
+    public var isDefault: Bool {
+        return self == NYXGiftFilter()
+    }
+}
diff --git a/Ghostgram/Features/GiftsStudio/Core/NYXGiftQuery.swift b/Ghostgram/Features/GiftsStudio/Core/NYXGiftQuery.swift
new file mode 100644
index 00000000..a21a059a
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/Core/NYXGiftQuery.swift
@@ -0,0 +1,103 @@
+import Foundation
+
+/// Pure search / filter / sort over a list of gifts. No Telegram types, fully unit-testable.
+public enum NYXGiftQuery {
+    public static func apply(_ items: [NYXGiftItem], filter: NYXGiftFilter, sort: NYXGiftSort, favorites: Set<String>) -> [NYXGiftItem] {
+        let needle = filter.search.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        let filtered = items.filter { item in
+            if !filter.kinds.isEmpty && !filter.kinds.contains(item.kind) {
+                return false
+            }
+            if filter.onlyFavorites && !favorites.contains(item.storageKey) {
+                return false
+            }
+            if filter.onlyPinned && item.ownership?.pinnedToTop != true {
+                return false
+            }
+            switch filter.visibility {
+            case .all:
+                break
+            case .shown:
+                if item.ownership?.savedToProfile != true { return false }
+            case .hidden:
+                guard let ownership = item.ownership, !ownership.savedToProfile else { return false }
+            }
+            if !needle.isEmpty && !NYXGiftQuery.searchText(item).contains(needle) {
+                return false
+            }
+            return true
+        }
+        return NYXGiftQuery.sorted(filtered, by: sort)
+    }
+
+    static func searchText(_ item: NYXGiftItem) -> String {
+        var parts = [item.title]
+        parts.append(contentsOf: item.attributes)
+        if let number = item.number {
+            parts.append("#\(number)")
+        }
+        if let rarity = item.rarity {
+            parts.append(rarity)
+        }
+        return parts.joined(separator: " ").lowercased()
+    }
+
+    public static func sorted(_ items: [NYXGiftItem], by sort: NYXGiftSort) -> [NYXGiftItem] {
+        // Every comparison falls back to the source order so the result is deterministic.
+        switch sort {
+        case .newest:
+            return items.sorted { a, b in
+                let da = a.ownership?.date ?? Int32.min
+                let db = b.ownership?.date ?? Int32.min
+                if da != db { return da > db }
+                return a.order < b.order
+            }
+        case .priceLow:
+            return items.sorted { a, b in
+                NYXGiftQuery.optionalLess(a.priceStars, b.priceStars, a.order, b.order, ascending: true)
+            }
+        case .priceHigh:
+            return items.sorted { a, b in
+                NYXGiftQuery.optionalLess(a.priceStars, b.priceStars, a.order, b.order, ascending: false)
+            }
+        case .name:
+            return items.sorted { a, b in
+                let c = a.title.localizedCaseInsensitiveCompare(b.title)
+                if c != .orderedSame { return c == .orderedAscending }
+                return a.order < b.order
+            }
+        case .scarcest:
+            return items.sorted { a, b in
+                NYXGiftQuery.optionalLess(a.total.map(Int64.init), b.total.map(Int64.init), a.order, b.order, ascending: true)
+            }
+        }
+    }
+
+    /// Values that are nil always go last, in both directions.
+    private static func optionalLess(_ a: Int64?, _ b: Int64?, _ ao: Int, _ bo: Int, ascending: Bool) -> Bool {
+        switch (a, b) {
+        case let (x?, y?):
+            if x != y { return ascending ? x < y : x > y }
+            return ao < bo
+        case (nil, nil):
+            return ao < bo
+        case (nil, _?):
+            return false
+        case (_?, nil):
+            return true
+        }
+    }
+}
+
+public enum NYXListMove {
+    /// Moves one element; out-of-range indices leave the list unchanged. `to` is the final index.
+    public static func move<T>(_ list: [T], from: Int, to: Int) -> [T] {
+        guard from != to, list.indices.contains(from), list.indices.contains(to) else {
+            return list
+        }
+        var result = list
+        let element = result.remove(at: from)
+        result.insert(element, at: to)
+        return result
+    }
+}
diff --git a/Ghostgram/Features/GiftsStudio/Core/NYXGiftsPrefs.swift b/Ghostgram/Features/GiftsStudio/Core/NYXGiftsPrefs.swift
new file mode 100644
index 00000000..006eda90
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/Core/NYXGiftsPrefs.swift
@@ -0,0 +1,101 @@
+import Foundation
+
+public enum NYXProfileStyle: String, Codable, CaseIterable {
+    case classic, minimal, premium, collector, midnight, nyxPurple
+}
+
+public enum NYXCardSize: String, Codable, CaseIterable {
+    case small, medium, large
+}
+
+/// A local arrangement of gifts. It is only ever a LOCAL preview unless the user explicitly applies the
+/// pinned order to Telegram (see the "Apply to Telegram" step in the UI).
+public struct NYXProfileComposition: Codable, Equatable, Identifiable {
+    public var id: UUID
+    public var name: String
+    /// `NYXGiftItem.storageKey` values, in display order.
+    public var giftKeys: [String]
+    public var primaryKey: String?
+    public var style: NYXProfileStyle
+    public var columns: Int
+    public var cardSize: NYXCardSize
+    public var showTitles: Bool
+    public var showRarity: Bool
+    public var maxItems: Int
+
+    public init(id: UUID = UUID(), name: String, giftKeys: [String] = [], primaryKey: String? = nil, style: NYXProfileStyle = .nyxPurple, columns: Int = 3, cardSize: NYXCardSize = .medium, showTitles: Bool = true, showRarity: Bool = false, maxItems: Int = 12) {
+        self.id = id
+        self.name = name
+        self.giftKeys = giftKeys
+        self.primaryKey = primaryKey
+        self.style = style
+        self.columns = min(max(columns, 2), 4)
+        self.cardSize = cardSize
+        self.showTitles = showTitles
+        self.showRarity = showRarity
+        self.maxItems = min(max(maxItems, 1), 50)
+    }
+
+    /// The keys that are actually shown, honouring `maxItems`, with the primary gift first.
+    public var visibleKeys: [String] {
+        var keys = self.giftKeys
+        if let primary = self.primaryKey, let index = keys.firstIndex(of: primary), index != 0 {
+            keys.remove(at: index)
+            keys.insert(primary, at: 0)
+        }
+        return Array(keys.prefix(self.maxItems))
+    }
+}
+
+public struct NYXChangeEntry: Codable, Equatable {
+    public var date: Date
+    public var text: String
+    public init(date: Date, text: String) {
+        self.date = date
+        self.text = text
+    }
+}
+
+/// Everything Gifts Studio keeps locally. Versioned so it can be migrated.
+public struct NYXGiftsPrefs: Codable, Equatable {
+    public static let currentVersion = 1
+    public static let maxNotes = 5000
+    public static let maxNoteLength = 2000
+    public static let maxCompositions = 50
+    public static let maxChangeLog = 200
+
+    public var schemaVersion: Int = NYXGiftsPrefs.currentVersion
+    public var favorites: [String] = []
+    public var notes: [String: String] = [:]
+    public var compositions: [NYXProfileComposition] = []
+    public var activeCompositionID: UUID?
+    public var catalogFilter: NYXGiftFilter = NYXGiftFilter()
+    public var catalogSort: NYXGiftSort = .name
+    public var collectionFilter: NYXGiftFilter = NYXGiftFilter()
+    public var collectionSort: NYXGiftSort = .newest
+    public var changeLog: [NYXChangeEntry] = []
+
+    public init() {}
+
+    /// Drops anything that breaks the limits (used after import and on load).
+    mutating func normalize() {
+        self.favorites = Array(NSOrderedSet(array: self.favorites).array as? [String] ?? self.favorites)
+        if self.notes.count > NYXGiftsPrefs.maxNotes {
+            let keep = self.notes.keys.sorted().prefix(NYXGiftsPrefs.maxNotes)
+            self.notes = self.notes.filter { keep.contains($0.key) }
+        }
+        for (key, value) in self.notes where value.count > NYXGiftsPrefs.maxNoteLength {
+            self.notes[key] = String(value.prefix(NYXGiftsPrefs.maxNoteLength))
+        }
+        self.notes = self.notes.filter { !$0.value.isEmpty }
+        if self.compositions.count > NYXGiftsPrefs.maxCompositions {
+            self.compositions = Array(self.compositions.prefix(NYXGiftsPrefs.maxCompositions))
+        }
+        if let active = self.activeCompositionID, !self.compositions.contains(where: { $0.id == active }) {
+            self.activeCompositionID = nil
+        }
+        if self.changeLog.count > NYXGiftsPrefs.maxChangeLog {
+            self.changeLog = Array(self.changeLog.suffix(NYXGiftsPrefs.maxChangeLog))
+        }
+    }
+}
diff --git a/Ghostgram/Features/GiftsStudio/Core/NYXGiftsStore.swift b/Ghostgram/Features/GiftsStudio/Core/NYXGiftsStore.swift
new file mode 100644
index 00000000..415e05ee
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/Core/NYXGiftsStore.swift
@@ -0,0 +1,186 @@
+import Foundation
+
+public enum NYXGiftsStoreIssue: Equatable {
+    /// The main file could not be read; the backup was used.
+    case restoredFromBackup
+    /// Neither file could be read; the damaged file was set aside and defaults are in use.
+    case resetAfterCorruption
+    /// The file was written by a newer NYXGram. It is left untouched and changes are kept in memory only.
+    case newerVersionReadOnly
+}
+
+public enum NYXGiftsImportError: Error, Equatable {
+    case notValidData
+    case newerVersion
+    case writeFailed
+}
+
+/// Local persistence for Gifts Studio: one JSON file, written atomically, with a backup of the previous
+/// good version. Corrupted data never crashes the app and never silently erases the user's settings:
+/// the damaged file is kept next to the new one.
+public final class NYXGiftsStore {
+    public static let shared = NYXGiftsStore(fileURL: NYXGiftsStore.defaultURL())
+
+    private let fileURL: URL
+    private let lock = NSLock()
+    private var prefs: NYXGiftsPrefs
+    private var readOnly = false
+    public private(set) var loadIssue: NYXGiftsStoreIssue?
+
+    public static func defaultURL() -> URL {
+        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0].appendingPathComponent("NYXGram", isDirectory: true)
+        return base.appendingPathComponent("gifts-studio.json")
+    }
+
+    public init(fileURL: URL) {
+        self.fileURL = fileURL
+        self.prefs = NYXGiftsPrefs()
+        try? FileManager.default.createDirectory(at: fileURL.deletingLastPathComponent(), withIntermediateDirectories: true, attributes: nil)
+        self.load()
+    }
+
+    private var backupURL: URL {
+        return self.fileURL.appendingPathExtension("bak")
+    }
+
+    // MARK: Access
+
+    public var current: NYXGiftsPrefs {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.prefs
+    }
+
+    public func update(_ change: (inout NYXGiftsPrefs) -> Void) {
+        self.lock.lock()
+        var next = self.prefs
+        change(&next)
+        next.schemaVersion = NYXGiftsPrefs.currentVersion
+        next.normalize()
+        let changed = next != self.prefs
+        self.prefs = next
+        if changed {
+            self.saveLocked()
+        }
+        self.lock.unlock()
+    }
+
+    /// Appends a line to the local change history ("what I changed in my gift layout").
+    public func log(_ text: String, now: Date = Date()) {
+        self.update { $0.changeLog.append(NYXChangeEntry(date: now, text: text)) }
+    }
+
+    /// Back to defaults. The previous file stays as the backup.
+    public func resetAll() {
+        self.update { $0 = NYXGiftsPrefs() }
+    }
+
+    // MARK: Export / import
+
+    public func exportData() -> Data? {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        encoder.dateEncodingStrategy = .iso8601
+        return try? encoder.encode(self.current)
+    }
+
+    /// Replaces the local settings with the imported ones after validating them.
+    public func importData(_ data: Data) throws {
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        guard data.count <= 5_000_000, var imported = try? decoder.decode(NYXGiftsPrefs.self, from: data) else {
+            throw NYXGiftsImportError.notValidData
+        }
+        if imported.schemaVersion > NYXGiftsPrefs.currentVersion {
+            throw NYXGiftsImportError.newerVersion
+        }
+        imported.schemaVersion = NYXGiftsPrefs.currentVersion
+        imported.normalize()
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        if self.readOnly {
+            throw NYXGiftsImportError.writeFailed
+        }
+        self.prefs = imported
+        if !self.saveLocked() {
+            throw NYXGiftsImportError.writeFailed
+        }
+    }
+
+    // MARK: Disk
+
+    private func decoder() -> JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .iso8601
+        return decoder
+    }
+
+    private func read(_ url: URL) -> NYXGiftsPrefs? {
+        guard let data = try? Data(contentsOf: url) else {
+            return nil
+        }
+        return try? self.decoder().decode(NYXGiftsPrefs.self, from: data)
+    }
+
+    private func load() {
+        let fm = FileManager.default
+        guard fm.fileExists(atPath: self.fileURL.path) else {
+            if fm.fileExists(atPath: self.backupURL.path), var backup = self.read(self.backupURL) {
+                backup.normalize()
+                self.prefs = backup
+                self.loadIssue = .restoredFromBackup
+            }
+            return
+        }
+        if var main = self.read(self.fileURL) {
+            if main.schemaVersion > NYXGiftsPrefs.currentVersion {
+                self.readOnly = true
+                self.loadIssue = .newerVersionReadOnly
+            }
+            main.normalize()
+            self.prefs = main
+            return
+        }
+        if var backup = self.read(self.backupURL) {
+            backup.normalize()
+            self.prefs = backup
+            self.loadIssue = .restoredFromBackup
+            self.setAsideCorruptFile()
+            self.saveLocked()
+            return
+        }
+        self.loadIssue = .resetAfterCorruption
+        self.setAsideCorruptFile()
+    }
+
+    private func setAsideCorruptFile() {
+        let stamp = Int(Date().timeIntervalSince1970)
+        let target = self.fileURL.appendingPathExtension("corrupt-\(stamp)")
+        try? FileManager.default.moveItem(at: self.fileURL, to: target)
+    }
+
+    @discardableResult
+    private func saveLocked() -> Bool {
+        guard !self.readOnly else {
+            return false
+        }
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        encoder.dateEncodingStrategy = .iso8601
+        guard let data = try? encoder.encode(self.prefs) else {
+            return false
+        }
+        let fm = FileManager.default
+        // Keep the previous good file as the backup before replacing it.
+        if fm.fileExists(atPath: self.fileURL.path), self.read(self.fileURL) != nil {
+            try? fm.removeItem(at: self.backupURL)
+            try? fm.copyItem(at: self.fileURL, to: self.backupURL)
+        }
+        do {
+            try data.write(to: self.fileURL, options: [.atomic])
+            return true
+        } catch {
+            return false
+        }
+    }
+}
diff --git a/Ghostgram/Features/GiftsStudio/Scripts/check-gifts-forbidden.sh b/Ghostgram/Features/GiftsStudio/Scripts/check-gifts-forbidden.sh
new file mode 100755
index 00000000..426586f4
--- /dev/null
+++ b/Ghostgram/Features/GiftsStudio/Scripts/check-gifts-forbidden.sh
@@ -0,0 +1,10 @@
+#!/bin/bash
+# Gifts Studio must never buy, send, transfer, convert, withdraw, upgrade, resell or delete gifts.
+# Fails when the feature sources call any of the TelegramCore functions that do that.
+cd "$(dirname "$0")/.." || exit 2
+pattern='buyStarGift|sendStarsGift|transferStarGift|convertStarGift|withdrawStarGift|upgradeStarGift|updateStarGiftResellPrice|deleteStarGift|removeStarGift|dropOriginalDetails|insertStarGifts|requestStarsPayment|sendStarsPaymentForm|craft\('
+if grep -nE "$pattern" Core/*.swift Sources/*.swift; then
+    echo "FORBIDDEN gift operation found in Gifts Studio sources" >&2
+    exit 1
+fi
+echo "OK: no purchase/transfer/convert/withdraw/upgrade/delete calls in Gifts Studio"
